                "value" : "IF EXISTS ( SELECT * FROM sys.external_tables WHERE object_id = OBJECT_ID('$in_p_ext_table_schema$.$in_p_ext_target_table$') )\n    DROP EXTERNAL TABLE $in_p_ext_table_schema$.$in_p_ext_target_table$"
              },
              {
                "name" : "Post SQL",
                "value" : "BEGIN TRY \n   DECLARE @create_ext_tbl_stmt NVARCHAR(max)\n   DECLARE @exec_create_ext_tabl_stmt NVARCHAR(max)\n   DECLARE @crt_ext_stmt NVARCHAR(MAX)\n   SET @create_ext_tbl_stmt=('select @crt_stmt = CONCAT(''CREATE EXTERNAL TABLE '',''$in_p_ext_table_schema$'',''.'', ''$in_p_ext_target_table$'',''('', \n   STRING_AGG(\n       CONCAT( COLUMN_NAME, '' '', DATA_TYPE, \n   \tCASE WHEN DATA_TYPE NOT IN (''bigint'',''int'',''bit'',''float'',''smallint'',''tinyint'',''money'',''smallmoney'',''real'',''date'',''datetime'',''smalldatetime'',''time'',''datetimeoffset'') THEN ''('' end, \n   \tCASE WHEN (DATA_TYPE=''nvarchar'' OR DATA_TYPE=''varchar'' OR DATA_TYPE=''nchar'' OR DATA_TYPE=''char'' OR DATA_TYPE=''varbinary'' OR DATA_TYPE=''binary'') THEN (CASE WHEN [CHARACTER_MAXIMUM_LENGTH] = -1 THEN ''max'' ELSE CAST([CHARACTER_MAXIMUM_LENGTH] as nvarchar) END) \n       WHEN (DATA_TYPE=''datetime2'') THEN CAST(DATETIME_PRECISION as nvarchar) \n       WHEN (DATA_TYPE=''numeric'' or DATA_TYPE=''decimal'') THEN CAST(CONCAT(NUMERIC_PRECISION,'','', NUMERIC_SCALE) as nvarchar)  END,  \n   \tCASE WHEN DATA_TYPE NOT IN (''bigint'',''int'',''bit'',''float'',''smallint'',''tinyint'',''money'',''smallmoney'',''real'',''date'',''datetime'',''smalldatetime'',''time'',''datetimeoffset'') THEN '')'' END) ,'', ''),'')''\n   ,''WITH (DATA_SOURCE = ['',''$in_p_data_source$'',''],LOCATION = N'''''',''$in_p_ext_file_path$'','''''',\n   FILE_FORMAT = ['',''$in_p_file_format$'',''],REJECT_TYPE = VALUE,REJECT_VALUE = $in_p_reject_value$)''\n   )\n   FROM INFORMATION_SCHEMA.COLUMNS \n   WHERE TABLE_NAME =''$in_p_target_table_str$'' and table_schema=''$in_p_target_schema_str$'' \n   and COLUMN_NAME NOT IN (''adf_create_date'',''adf_active_row'',''adf_end_date'',''adf_batch_id'',''adf_row_key'',''adf_kp_region_code'')\n   ')\n   exec sp_executesql @create_ext_tbl_stmt, N'@crt_stmt NVARCHAR(MAX) OUTPUT', @crt_stmt = @crt_ext_stmt OUTPUT\n   print @crt_ext_stmt\n   EXEC (@crt_ext_stmt)\nEND TRY\nBEGIN CATCH       \n DECLARE @MessageText NVARCHAR(max);\n SET @MessageText = ERROR_MESSAGE();  \n THROW 60000,@MessageText,1;\nEND CATCH;"
